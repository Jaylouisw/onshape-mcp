+                except Exception:
+                    pass
+                if not detail:
+                    detail = (getattr(resp, "text", "") or "").strip()[:200]
+                raise RuntimeError(
+                    f"Onshape API {resp.status_code} on {method} {url}: {detail or 'request failed'}"
+                )
